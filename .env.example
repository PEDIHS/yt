# -----------------------------
# Telegram bot
# -----------------------------
TELEGRAM_BOT_TOKEN=1234567890:replace_me
# Comma-separated numeric Telegram user IDs allowed to control the bot.
TELEGRAM_ADMIN_IDS=123456789

# -----------------------------
# Web panel security
# -----------------------------
PANEL_USERNAME=admin
PANEL_PASSWORD=replace_with_a_long_password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace_with_a_long_random_secret
# Optional explicit Fernet key. If empty, a stable key is derived from SECRET_KEY.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Public HTTPS URL used for Google OAuth callbacks and Telegram one-time connect links.
PUBLIC_BASE_URL=https://example.com
PANEL_HOST=0.0.0.0
PANEL_PORT=8080

# -----------------------------
# Google / YouTube OAuth
# -----------------------------
CLIENT_SECRET_FILE=client_secret.json

# -----------------------------
# Instagram / downloader
# -----------------------------
INSTAGRAM_SESSIONID=
FFMPEG_PATH=
DEFAULT_HASHTAGS=#Shorts #YouTubeShorts #reels

# -----------------------------
# Data / worker settings
# -----------------------------
DATABASE_URL=sqlite:///data/app.db
MAX_WORKERS=2
OAUTH_LINK_MINUTES=10
MAX_UPLOAD_HISTORY=100
