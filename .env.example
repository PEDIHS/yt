# Telegram
TELEGRAM_BOT_TOKEN=1234567890:replace_with_your_bot_token

# Instagram (optional, may be required for authenticated/private access)
INSTAGRAM_SESSIONID=replace_with_your_instagram_session_id

# YouTube OAuth
CLIENT_SECRET_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# Bot defaults
DEFAULT_HASHTAGS=#Shorts #YouTubeShorts #reels

# Optional: explicit FFmpeg binary or directory path.
# Leave empty to let yt-dlp discover FFmpeg from PATH.
FFMPEG_PATH=
